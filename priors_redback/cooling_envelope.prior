# cooling_envelope, regenerated from redback.priors.get_priors('cooling_envelope').
# An exact copy of what redback ships: no key is overridden here.
# Constraints are NOT in this file; redback_priors loads them with
# get_priors(model, constraint=True) and this file only overrides keys.
#
# redback's own file carries this warning, and to_file() drops comments, so it
# is restored here deliberately: the constraints (eta_min, beta_max) are NOT in
# this file. They come from get_priors(model, constraint=True), which
# redback_priors calls; this file only overrides keys on top of that. Loading
# it alone would compute the constraint ratio and then discard it, which is the
# bug this pipeline used to have.

redshift = Uniform(minimum=1e-06, maximum=3, name='redshift', latex_label='$z$', unit=None, boundary=None)
mbh_6 = LogUniform(minimum=0.1, maximum=10, name='mbh_6', latex_label='$M_{\\mathrm{BH}}~[10^{6}~M_{\\odot}]$', unit=None, boundary=None)
stellar_mass = LogUniform(minimum=0.5, maximum=10, name='stellar_mass', latex_label='$M_{\\mathrm{star}}[M_{\\odot}]$', unit=None, boundary=None)
eta = LogUniform(minimum=0.0001, maximum=0.1, name='eta', latex_label='$\\eta$', unit=None, boundary=None)
alpha = LogUniform(minimum=0.1, maximum=1, name='alpha', latex_label='$\\alpha$', unit=None, boundary=None)
beta = Uniform(minimum=1, maximum=5, name='beta', latex_label='$\\beta$', unit=None, boundary=None)
