# shock_cooling, regenerated from redback.priors.get_priors('shock_cooling').
# An exact copy of what redback ships: no key is overridden here.
# Constraints are NOT in this file; redback_priors loads them with
# get_priors(model, constraint=True) and this file only overrides keys.

redshift = Uniform(minimum=0.001, maximum=3, name='redshift', latex_label='$z$', unit=None, boundary=None)
log10_mass = Uniform(minimum=-2, maximum=3, name='log10_mass', latex_label='$\\log_{10}~m_{\\mathrm{en}}/M_\\odot$', unit=None, boundary=None)
log10_radius = Uniform(minimum=10, maximum=14, name='log10_radius', latex_label='$\\log_{10}~R_{\\mathrm{en}}/{\\mathrm{cm}}$', unit=None, boundary=None)
log10_energy = Uniform(minimum=40, maximum=52, name='log10_energy', latex_label='$\\log_{10}~E_{\\mathrm{en}}/{\\mathrm{erg}}$', unit=None, boundary=None)
nn = Uniform(minimum=8, maximum=12, name='nn', latex_label='$nn$', unit=None, boundary=None)
delta = Uniform(minimum=1, maximum=1.5, name='delta', latex_label='$\\Delta$', unit=None, boundary=None)
