luminosity_distance = Uniform(minimum=1e-3, maximum=7000, name='luminosity_distance',latex_label='$D_L$')
timeshift = Uniform(minimum=-30.0, maximum=30.0, name='trigger_time',latex_label='$t_0$')
supernova_mag_boost = Uniform(name='supernova_mag_boost', minimum=-10., maximum=10., latex_label='$\\rm{SNmag}$')
