luminosity_distance = Uniform(minimum=0.001, maximum=7000, name='luminosity_distance', latex_label='$D_L$', unit=None, boundary=None)
timeshift = Uniform(minimum=-30.0, maximum=30.0, name='trigger_time', latex_label='$t_0$', unit=None, boundary=None)
supernova_mag_boost = Uniform(minimum=-5.0, maximum=5.0, name='supernova_mag_boost', latex_label='$\\rm{SNmag}$', unit=None, boundary=None)
